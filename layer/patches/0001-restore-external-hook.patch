From 9b2aeb8accc5ecfcd893b81111929dc5579b47b7 Mon Sep 17 00:00:00 2001
From: "Baptiste G." <70719480+BeeeFX@users.noreply.github.com>
Date: Sat, 31 Oct 2026 01:19:02 +0000
Subject: [PATCH] paint: restore the external plugin hook

What: compile paint/plugins/external/ in when it exists and call its external_init() from plugins_init(), as upstream did until 4f08044
Size: 15 lines in paint/plugins/project.c, paint/plugins/plugins.c
Upstream: local, because upstream removed the hook on 22 October 2026 (4f08044 "paint: cleanup"); offered back in https://github.com/armory3d/armorpaint/issues/2185 (12 November 2026)
Gap: every item (the layer's native module, layer/native/, is compiled in through this hook)
---
 paint/plugins/plugins.c | 8 ++++++++
 paint/plugins/project.c | 7 +++++++
 2 files changed, 15 insertions(+)

diff --git a/paint/plugins/plugins.c b/paint/plugins/plugins.c
index 8bdba5ec..4de30649 100644
--- a/paint/plugins/plugins.c
+++ b/paint/plugins/plugins.c
@@ -112,6 +112,10 @@ static void *import_fbx(char *path) {
 	return res;
 }
 
+#ifdef WITH_EXTERNAL
+void external_init();
+#endif
+
 void plugins_init() {
 	path_texture_formats(); // Init array
 	any_map_set(import_texture_importers, "exr", import_exr);
@@ -134,6 +138,10 @@ void plugins_init() {
 	any_array_push(_path_mesh_formats, "fbx");
 
 	bake_maps_init();
+
+#ifdef WITH_EXTERNAL
+	external_init();
+#endif
 }
 
 #endif
diff --git a/paint/plugins/project.c b/paint/plugins/project.c
index 86ba5264..4b4ffe6a 100644
--- a/paint/plugins/project.c
+++ b/paint/plugins/project.c
@@ -15,5 +15,12 @@ project_t *main() {
 	add_define(project, "UFBX_ENABLE_TRIANGULATION");
 	add_define(project, "UFBX_ENABLE_SCENE_EVALUATION");
 
+	if (fs_exists("external")) {
+		add_cfiles(project, "external/**");
+		add_shaders(project, "external/*.shader");
+		add_assets(project, "external/assets/*", "data/{name}", 0);
+		add_define(project, "WITH_EXTERNAL");
+	}
+
 	return project;
 }
-- 
